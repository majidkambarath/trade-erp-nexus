# Used by `vite build` (production mode) so a build with no dashboard
# environment variables still points at the deployed site's own relative API
# path instead of http://localhost:3000/api/v1. A Render/CI VITE_API_URL
# overrides this. Relative, not the bare backend host: the API is proxied
# through this frontend's own /api/* rewrite (render.yaml, CLAUDE.md
# "Deployment (Render)"), so the backend's address stays out of the bundle.
VITE_API_URL=/api/v1
